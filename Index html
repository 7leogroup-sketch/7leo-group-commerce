            { id: 6, name: "7Leo Minimalist Cap", category: "apparel", price: 29.99, image: "https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=500&auto=format&fit=crop&q=60", description: "Adjustable premium cotton twill baseball cap with embroidered 7Leo logo." }
        ];

        const bgmTracks = [
            { id: 1, title: "Neon Horizon", category: "Drive", duration: "2:45" },
            { id: 2, title: "Cybernetic Pulse", category: "DJ", duration: "3:10" },
            { id: 3, title: "Ethereal Valleys", category: "Chill", duration: "4:05" },
            { id: 4, title: "Titanium Drive", category: "Cinematic", duration: "2:50" },
            { id: 5, title: "Midnight Velocity", category: "Gangster", duration: "3:30" },
            { id: 6, title: "7Leo Anthem", category: "Songs", duration: "3:15" }
        ];

        /* --- STATE MANAGEMENT --- */
        let state = {
            cart: JSON.parse(localStorage.getItem('7leo_cart')) || [],
            user: JSON.parse(localStorage.getItem('7leo_user')) || null,
            currentTrackIndex: null,
            isPlaying: false
        };

        /* --- UI NAVIGATION HELPERS --- */
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function toggleCartModal(open) {
            const modal = document.getElementById('cart-modal');
