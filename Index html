                modal.classList.remove('hidden');
                updateCartUI();
            } else {
                modal.classList.add('hidden');
            }
        }

        function toggleAccountModal(open) {
            const modal = document.getElementById('account-modal');
            if (open) {
                modal.classList.remove('hidden');
                updateAccountModalView();
            } else {
                modal.classList.add('hidden');
            }
        }

        function openCheckoutModal() {
            if (state.cart.length === 0) return;
            toggleCartModal(false);
            const summary = document.getElementById('checkout-summary');
            const total = state.cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            summary.innerHTML = `
                <div class="flex justify-between font-bold text-white mb-2">
                    <span>Items (${state.cart.reduce((s, i) => s + i.quantity, 0)})</span>
                    <span>$${total.toFixed(2)}</span>
                </div>
                <div class="text-zinc-400 space-y-1">
                    ${state.cart.map(i => `<div>• ${i.name} (x${i.quantity})</div>`).join('')}
                </div>
            `;
            document.getElementById('checkout-modal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function handleCheckoutSubmit(e) {
            e.preventDefault();
            alert("Checkout integration ready: Connect to your payment gateway (Stripe / PayPal) API endpoint.");
            closeCheckoutModal();
        }

        /* --- STORE LOGIC --- */
        function renderStoreProducts(productsToRender = storeProducts) {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = productsToRender.map(product => `
                <div class="glass-card rounded-3xl overflow-hidden group hover:border-brand/40 transition-all flex flex-col justify-between">
                    <div>
                        <div class="relative overflow-hidden aspect-video bg-zinc-950 cursor-pointer" onclick="openProductModal(${product.id})">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=60'">
                            <span class="absolute top-3 left-3 bg-zinc-950/80 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-semibold text-brand uppercase">${product.category}</span>
                        </div>
                        <div class="p-6 space-y-2">
                            <h3 onclick="openProductModal(${product.id})" class="text-base font-bold text-white cursor-pointer hover:text-brand transition-colors">${product.name}</h3>
                            <p class="text-zinc-400 text-xs line-clamp-2">${product.description}</p>
                        </div>
                    </div>
                    <div class="p-6 pt-0 flex items-center justify-between">
                        <span class="text-base font-extrabold text-white">$${product.price.toFixed(2)}</span>
                        <button onclick="addToCart(${product.id})" class="px-4 py-2.5 rounded-xl bg-brand text-black font-bold text-xs hover:bg-brand-light transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-cart-plus"></i>
                            <span>Add</span>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function filterStoreProducts() {
            const search = document.getElementById('store-search').value.toLowerCase();
            const category = document.getElementById('store-category').value;

            const filtered = storeProducts.filter(p => {
                const matchesSearch = p.name.toLowerCase().includes(search) || p.description.toLowerCase().includes(search);
                const matchesCat = category === 'all' || p.category === category;
                return matchesSearch && matchesCat;
            });
            renderStoreProducts(filtered);
        }

        function openProductModal(productId) {
            const product = storeProducts.find(p => p.id === productId);
            if (!product) return;

            const content = document.getElementById('product-modal-content');
            content.innerHTML = `
                <div class="rounded-2xl overflow-hidden bg-zinc-950 aspect-square">
                    <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover">
                </div>
                <div class="space-y-4">
                    <span class="px-3 py-1 rounded-full bg-brand/10 text-brand text-xs font-semibold uppercase">${product.category}</span>
                    <h2 class="text-2xl font-extrabold text-white">${product.name}</h2>
                    <p class="text-xl font-extrabold text-brand">$${product.price.toFixed(2)}</p>
                    <p class="text-zinc-400 text-xs leading-relaxed">${product.description}</p>
                    <button onclick="addToCart(${product.id}); closeProductModal();" class="w-full py-3.5 rounded-xl bg-brand text-black font-bold text-xs hover:bg-brand-light transition-all">Add to Cart</button>
                </div>
            `;
            document.getElementById('product-modal').classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        /* --- CART LOGIC --- */
        function addToCart(productId) {
            const product = storeProducts.find(p => p.id === productId);
            if (!product) return;

            const existing = state.cart.find(item => item.id === productId);
            if (existing) {
                existing.quantity += 1;
            } else {
                state.cart.push({ ...product, quantity: 1 });
            }
            saveCart();
            updateCartUI();
            toggleCartModal(true);
        }

        function updateQuantity(productId, delta) {
            const item = state.cart.find(i => i.id === productId);
            if (!item) return;
            item.quantity += delta;
            if (item.quantity <= 0) {
                state.cart = state.cart.filter(i => i.id !== productId);
            }
            saveCart();
            updateCartUI();
        }

        function removeFromCart(productId) {
            state.cart = state.cart.filter(i => i.id !== productId);
            saveCart();
            updateCartUI();
        }

        function saveCart() {
            localStorage.setItem('7leo_cart', JSON.stringify(state.cart));
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const totalItems = state.cart.reduce((sum, i) => sum + i.quantity, 0);
            if (totalItems > 0) {
                badge.innerText = totalItems;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            const container = document.getElementById('cart-items-container');
            if (state.cart.length === 0) {
                container.innerHTML = `<p class="text-zinc-500 text-xs text-center py-8">Your cart is currently empty.</p>`;
            } else {
                container.innerHTML = state.cart.map(item => `
                    <div class="flex items-center justify-between bg-zinc-900 border border-zinc-800 rounded-2xl p-3">
                        <div class="flex items-center space-x-3">
                            <img src="${item.image}" alt="${item.name}" class="w-10 h-10 rounded-xl object-cover">
                            <div>
                                <h4 class="text-xs font-bold text-white">${item.name}</h4>
                                <span class="text-xs text-brand font-semibold">$${(item.price * item.quantity).toFixed(2)}</span>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <div class="flex items-center space-x-1.5 bg-zinc-950 px-2 py-1 rounded-lg border border-zinc-800">
                                <button onclick="updateQuantity(${item.id}, -1)" class="text-zinc-400 hover:text-white"><i class="fa-solid fa-minus text-[9px]"></i></button>
                                <span class="text-xs font-bold text-white">${item.quantity}</span>
                                <button onclick="updateQuantity(${item.id}, 1)" class="text-zinc-400 hover:text-white"><i class="fa-solid fa-plus text-[9px]"></i></button>
                            </div>
                            <button onclick="removeFromCart(${item.id})" class="text-zinc-500 hover:text-red-400 p-1"><i class="fa-solid fa-trash text-xs"></i></button>
                        </div>
                    </div>
                `).join('');
            }

            const subtotal = state.cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            document.getElementById('cart-subtotal-price').innerText = `$${subtotal.toFixed(2)}`;
        }

        /* --- BGM & PLAYER LOGIC --- */
        function renderBgmTracks(tracksToRender = bgmTracks) {
            const list = document.getElementById('bgm-track-list');
            list.innerHTML = tracksToRender.map((track, idx) => `
                <div class="glass-card flex items-center justify-between rounded-2xl p-4 border border-zinc-800 hover:border-brand/40 transition-all group">
                    <div class="flex items-center space-x-4">
                        <button onclick="playTrack(${track.id})" class="w-10 h-10 rounded-xl bg-brand/10 border border-brand/20 group-hover:bg-brand group-hover:text-black text-brand flex items-center justify-center transition-all">
                            <i class="fa-solid fa-play text-xs"></i>
                        </button>
                        <div>
                            <h4 class="text-xs sm:text-sm font-bold text-white">${track.title}</h4>
                            <span class="text-[10px] text-zinc-400 uppercase tracking-wider">${track.category} Series</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <span class="text-xs text-zinc-400 font-mono">${track.duration}</span>
                        <a href="#contact" onclick="document.getElementById('contact-subject').value='Licensing Inquiry: ${track.title}'; document.getElementById('contact-category').value='Music Licensing';" class="px-3 py-1.5 rounded-xl bg-zinc-950 border border-zinc-800 text-[10px] font-semibold text-zinc-300 hover:text-brand transition-colors">License</a>
                    </div>
                </div>
            `).join('');
        }

        function filterBgmCategory(category) {
            document.querySelectorAll('.bgm-cat-btn').forEach(btn => {
                if (btn.innerText.includes(category) || (category === 'all' && btn.innerText === 'All Tracks')) {
                    btn.className = "bgm-cat-btn px-4 py-2 rounded-xl bg-brand text-black font-semibold text-xs whitespace-nowrap transition-all";
                } else {
                    btn.className = "bgm-cat-btn px-4 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 font-semibold text-xs whitespace-nowrap hover:border-zinc-700 transition-all";
                }
            });

            if (category === 'all') {
                renderBgmTracks(bgmTracks);
            } else {
                renderBgmTracks(bgmTracks.filter(t => t.category === category));
            }
        }

        function playTrack(trackId) {
            const track = bgmTracks.find(t => t.id === trackId);
            if (!track) return;

            state.currentTrackIndex = bgmTracks.findIndex(t => t.id === trackId);
            state.isPlaying = true;

            document.getElementById('bgm-player-bar').classList.remove('hidden');
            document.getElementById('player-title').innerText = track.title;
            document.getElementById('player-category').innerText = `${track.category} Series`;
            document.getElementById('player-play-icon').className = "fa-solid fa-pause text-xs";
            document.getElementById('player-duration').innerText = track.duration;
            document.getElementById('player-progress').style.width = '30%';
        }

        function togglePlayPause() {
            if (state.currentTrackIndex === null) {
                playTrack(bgmTracks[0].id);
                return;
            }
            state.isPlaying = !state.isPlaying;
            document.getElementById('player-play-icon').className = state.isPlaying ? "fa-solid fa-pause text-xs" : "fa-solid fa-play text-xs";
        }

        function playNextTrack() {
            if (state.currentTrackIndex === null) return;
            state.currentTrackIndex = (state.currentTrackIndex + 1) % bgmTracks.length;
            playTrack(bgmTracks[state.currentTrackIndex].id);
        }

        function playPrevTrack() {
            if (state.currentTrackIndex === null) return;
            state.currentTrackIndex = (state.currentTrackIndex - 1 + bgmTracks.length) % bgmTracks.length;
            playTrack(bgmTracks[state.currentTrackIndex].id);
        }

        function closeBgmPlayer() {
            state.isPlaying = false;
            state.currentTrackIndex = null;
            document.getElementById('bgm-player-bar').classList.add('hidden');
        }

        function seekAudio(event) {
            const rect = event.currentTarget.getBoundingClientRect();
            const pos = (event.clientX - rect.left) / rect.width;
            document.getElementById('player-progress').style.width = `${pos * 100}%`;
        }

        function adjustVolume(val) {}

        function handleLicensingSubmit(e) {
            e.preventDefault();
            alert("Licensing inquiry submitted successfully. Configuration Ready: Connect to backend mail service or CRM API.");
            e.target.reset();
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            alert("Message submitted successfully. Configuration Ready: Connect to backend mail service.");
            e.target.reset();
        }

        /* --- AUTHENTICATION & ACCOUNT PORTAL LOGIC --- */
        function switchAuthTab(tab) {
            const signinBtn = document.getElementById('tab-signin-btn');
            const signupBtn = document.getElementById('tab-signup-btn');
            const signinForm = document.getElementById('form-signin');
            const signupForm = document.getElementById('form-signup');

            if (tab === 'signin') {
                signinBtn.className = "py-2.5 rounded-xl text-xs font-bold bg-brand text-black transition-all";
                signupBtn.className = "py-2.5 rounded-xl text-xs font-bold text-zinc-400 hover:text-white transition-all";
                signinForm.classList.remove('hidden');
                signupForm.classList.add('hidden');
            } else {
                signupBtn.className = "py-2.5 rounded-xl text-xs font-bold bg-brand text-black transition-all";
                signinBtn.className = "py-2.5 rounded-xl text-xs font-bold text-zinc-400 hover:text-white transition-all";
                signupForm.classList.remove('hidden');
                signinForm.classList.add('hidden');
            }
            clearAuthFeedback();
        }

        function togglePasswordVisibility(fieldId, btn) {
            const input = document.getElementById(fieldId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = '<i class="fa-solid fa-eye-slash"></i>';
            } else {
                input.type = 'password';
                btn.innerHTML = '<i class="fa-solid fa-eye"></i>';
            }
        }

        function showAuthFeedback(msg, type = 'error') {
            const fb = document.getElementById('auth-feedback');
            fb.classList.remove('hidden', 'bg-red-500/10', 'text-red-400', 'border', 'border-red-500/20', 'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20');
            if (type === 'error') {
                fb.classList.add('bg-red-500/10', 'text-red-400', 'border', 'border-red-500/20');
            } else {
                fb.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border', 'border-emerald-500/20');
            }
            fb.innerText = msg;
        }

        function clearAuthFeedback() {
            const fb = document.getElementById('auth-feedback');
            fb.classList.add('hidden');
            fb.innerText = '';
        }

        function handleSignInSubmit(e) {
            e.preventDefault();
            clearAuthFeedback();
            const email = document.getElementById('signin-email').value.trim();
            const password = document.getElementById('signin-password').value;
            if (!email || !password) {
                showAuthFeedback("Please fill in all required fields.");
                return;
            }
            loginUser({ name: email.split('@')[0], email: email });
        }

        function handleSignUpSubmit(e) {
            e.preventDefault();
            clearAuthFeedback();
            const name = document.getElementById('signup-name').value.trim();
            const email = document.getElementById('signup-email').value.trim();
            const password = document.getElementById('signup-password').value;
            const confirmPassword = document.getElementById('signup-confirm-password').value;

            if (!name || !email || !password || !confirmPassword) {
                showAuthFeedback("All fields are required.");
                return;
            }
            if (password !== confirmPassword) {
                showAuthFeedback("Passwords do not match.");
                return;
            }
            if (password.length < 8) {
                showAuthFeedback("Password must be at least 8 characters long.");
                return;
            }
            loginUser({ name, email });
        }

        function handleGoogleAuth() {
            showAuthFeedback("Google OAuth Integration Ready: Configure Google Client ID and Firebase/Supabase redirect URI.", 'success');
        }

        function handleAppleAuth() {
            showAuthFeedback("Apple Sign-In Integration Ready: Configure Apple Developer Services ID and keys.", 'success');
        }

        function loginUser(userData) {
            state.user = userData;
            localStorage.setItem('7leo_user', JSON.stringify(userData));
            updateAccountModalView();
        }

        function handleLogout() {
            state.user = null;
            localStorage.removeItem('7leo_user');
            updateAccountModalView();
        }

        function updateAccountModalView() {
            const authView = document.getElementById('auth-view');
            const dashView = document.getElementById('dashboard-view');
            const navLabel = document.getElementById('nav-account-label');
            const mobileNavLabel = document.getElementById('mobile-account-label');

            if (state.user) {
                authView.classList.add('hidden');
                dashView.classList.remove('hidden');
                document.getElementById('user-display-name').innerText = state.user.name;
                document.getElementById('user-display-email').innerText = state.user.email;
                document.getElementById('user-avatar-initials').innerText = state.user.name.substring(0, 2).toUpperCase();
                navLabel.innerText = 'Account';
                mobileNavLabel.innerText = state.user.name;
            } else {
                authView.classList.remove('hidden');
                dashView.classList.add('hidden');
                navLabel.innerText = 'Account';
                mobileNavLabel.innerText = 'Account Portal';
            }
        }

        /* --- INITIALIZATION --- */
        window.addEventListener('DOMContentLoaded', () => {
            renderStoreProducts();
            renderBgmTracks();
            updateCartUI();
            updateAccountModalView();
        });
    </script>
</body>
</html>
